# Copy to .env.local and fill in.

# ---- LiveKit (video/audio/screen share) ----
# Get these from https://cloud.livekit.io (or your self-hosted server).
LIVEKIT_API_KEY=your_api_key          # server-side only
LIVEKIT_API_SECRET=your_api_secret    # server-side only
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Allow demo (no-wallet) identities to join rooms. Set both to "false" in
# production so only signature-verified wallets can connect. The NEXT_PUBLIC_
# one lets the browser disable the demo fallback too.
LIVEKIT_ALLOW_DEMO=true
NEXT_PUBLIC_ALLOW_DEMO=true

# ---- Wallet auth ----
# Secret used to sign/verify sign-in challenges. Use a long random string.
AUTH_SECRET=change-me-to-a-long-random-string

# Map a coin ticker to its dev/creator address (only that wallet can host it).
# Useful for testing the holder "Join" path with a second wallet.
# DEV_OVERRIDES=HOOD:0xabc...,PERP:0xdef...

# ---- RobinHood Chain (EVM) ----
# The real RobinHood Chain mainnet values are baked in as defaults (chain id
# 4663, RPC https://rpc.mainnet.chain.robinhood.com), so the wallet will offer
# to switch/add the network automatically with no config here.

# Switch the baked-in defaults to testnet (chain id 46630):
NEXT_PUBLIC_CHAIN_ENV=mainnet     # or "testnet"

# Optional per-field overrides (only needed to point at a custom RPC etc.):
# NEXT_PUBLIC_CHAIN_ID=4663
# NEXT_PUBLIC_CHAIN_NAME=RobinHood Chain
# NEXT_PUBLIC_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# NEXT_PUBLIC_CHAIN_EXPLORER_URL=https://robinhoodchain.blockscout.com
# NEXT_PUBLIC_CHAIN_SYMBOL=ETH

# On-chain balance reading additionally requires populating TOKEN_REGISTRY in
# lib/chain.ts with real token contract addresses. Until then the holdings list
# falls back to demo data.

# ---- Supabase (token launch registry) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
